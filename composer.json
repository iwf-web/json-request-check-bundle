{
    "name": "iwf-web/json-request-check-bundle",
    "description": "Symfony bundle to protect against HashDos attacks by limiting JSON request size",
    "type": "symfony-bundle",
    "keywords": [
        "symfony",
        "bundle",
        "json",
        "request",
        "dos",
        "hashdos",
        "security"
    ],
    "homepage": "https://github.com/iwf-web/json-request-check-bundle",
    "license": "MIT",
    "authors": [
        {
            "name": "Nick Steinwand",
            "email": "n.steinwand@iwf.ch",
            "homepage": "https://github.com/steinwandnick",
            "role": "Maintainer"
        }
    ],
    "support": {
        "email": "developer@iwf.ch",
        "issues": "https://github.com/iwf-web/json-request-check-bundle/issues",
        "forum": "https://github.com/iwf-web/json-request-check-bundle/discussions",
        "wiki": "https://github.com/iwf-web/json-request-check-bundle/wiki",
        "source": "https://github.com/iwf-web/json-request-check-bundle",
        "docs": "https://github.com/iwf-web/json-request-check-bundle/blob/main/README.md"
    },
    "require": {
        "php": ">=8.2",
        "symfony/framework-bundle": "^6.0 || ^7.0",
        "symfony/dependency-injection": "^6.0 || ^7.0",
        "symfony/http-kernel": "^6.0 || ^7.0",
        "symfony/config": "^6.0 || ^7.0"
    },
    "autoload": {
        "psr-4": {
            "IWFWeb\\JsonRequestCheckBundle\\": "src/"
        },
        "files": [
            "src/legacy_autoload.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "IWFWeb\\JsonRequestCheckBundle\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "tools:install": "@composer install --working-dir=tools",
        "tools:update": "@composer update --working-dir=tools",
        "php-cs-fixer:check": "tools/vendor/bin/php-cs-fixer check --diff",
        "php-cs-fixer:fix": "tools/vendor/bin/php-cs-fixer fix",
        "phpstan": "tools/vendor/bin/phpstan analyse",
        "phpstan:baseline": "tools/vendor/bin/phpstan analyse --generate-baseline",
        "lint": [
            "@php-cs-fixer:check",
            "@phpstan"
        ],
        "fix": [
            "@php-cs-fixer:fix"
        ]
    },
    "scripts-descriptions": {
        "tools:install": "Install composer-managed dev tools (php-cs-fixer, phpstan + extensions) into tools/vendor",
        "tools:update": "Update composer-managed dev tools in tools/vendor",
        "php-cs-fixer:check": "Run php-cs-fixer in dry-run mode and show a diff of style violations",
        "php-cs-fixer:fix": "Run php-cs-fixer and apply style fixes in place",
        "phpstan": "Run phpstan static analysis using phpstan.dist.neon",
        "phpstan:baseline": "Regenerate the phpstan baseline file",
        "lint": "Run all read-only checks (php-cs-fixer:check + phpstan)",
        "fix": "Run all auto-fixers (php-cs-fixer:fix)"
    }
}
